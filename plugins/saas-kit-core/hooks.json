{
  "agentshield-pre-tool-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-tool-guard.mjs --harness antigravity",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
