{
  "version": "2.0.0",
  "marketplace": {
    "name": "saas-kit",
    "repo": "naviocean/sass-kit",
    "owner": {
      "name": "naviocean",
      "url": "https://github.com/naviocean"
    }
  },
  "squads": {
    "core": {
      "pluginId": "saas-kit-core",
      "name": "SaaS Kit Core (Orchestration & Quality Gate)",
      "description": "2-mode orchestration brain (saas-help, saas-mode), 13 lazy playbooks (incl. saas-swarm, automate-me, reflect, correct), Tech Lead, PM, QA, Security Auditor, multi-harness AgentShield hooks, and dynamic model presets.",
      "defaultEnabled": true,
      "agents": [
        "tech-lead",
        "pm",
        "qa",
        "security-auditor"
      ],
      "routerSkills": [
        "saas-help",
        "saas-mode",
        "core-engineering",
        "qa-security-expert"
      ]
    },
    "web-frontend": {
      "pluginId": "saas-kit-web-frontend",
      "name": "Web Frontend & UI/UX Design Squad",
      "description": "Senior Frontend Engineer & UI/UX Designer for Next.js, React, Tailwind CSS v4, Shadcn, design systems, and Stitch/Pencil workflows.",
      "defaultEnabled": false,
      "agents": [
        "frontend",
        "designer"
      ],
      "routerSkills": [
        "frontend-expert",
        "designer-expert"
      ]
    },
    "nestjs-backend": {
      "pluginId": "saas-kit-nestjs-backend",
      "name": "NestJS & TypeScript Backend Squad",
      "description": "Senior NestJS Backend Engineer for NestJS architecture, Prisma ORM, PostgreSQL schema design, JWT auth, and OpenAPI REST/GraphQL.",
      "defaultEnabled": false,
      "agents": [
        "nestjs"
      ],
      "routerSkills": [
        "nestjs-expert"
      ]
    },
    "python-ai": {
      "pluginId": "saas-kit-python-ai",
      "name": "Python & AI Engineering Squad",
      "description": "Senior AI Engineer & Python Backend Engineer for LangGraph, RAG, LLM evaluation, FastAPI microservices, and async Python workers.",
      "defaultEnabled": false,
      "agents": [
        "ai-engineer",
        "python-backend"
      ],
      "routerSkills": [
        "ai-engineer-expert",
        "python-backend-expert"
      ]
    },
    "rust-systems": {
      "pluginId": "saas-kit-rust-systems",
      "name": "Rust Systems & Desktop Squad",
